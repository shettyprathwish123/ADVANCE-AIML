import tkinter as tk

# Create window
root = tk.Tk()
root.title("My First GUI")

# Label
label = tk.Label(root, text="Hello, Tkinter!", font=("Arial", 16))
label.pack(pady=20)

# Button
def say_hello():
    label.config(text="Button Clicked!")

button = tk.Button(root, text="Click Me", command=say_hello)
button.pack(pady=10)

# Run GUI
root.mainloop()
